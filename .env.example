# Server
PORT=3040
DRAIN_TIMEOUT=300

# Twilio (Voice)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_PUBLIC_URL=https://your-public-url.example.com
# Optional: pin a Twilio edge close to where this server runs
# (e.g. singapore, frankfurt, ashburn). Unset = Twilio default routing.
# TWILIO_EDGE=singapore

# Speech-to-Text (Deepgram Flux)
DEEPGRAM_API_KEY=your_deepgram_api_key
# Optional: override the Deepgram endpoint. Default is the US endpoint.
# The Python original was pinned to the EU endpoint:
# DEEPGRAM_BASE_URL=wss://api.eu.deepgram.com

# LLM (Groq drives the conversation)
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile

# Optional: only used by the /bench/ttft benchmark endpoint
OPENAI_API_KEY=your_openai_api_key

# Text-to-Speech (ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
